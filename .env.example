# ============================================================================
# Kalvid AI — environment template.
# Copy to .env and fill in.  .env is gitignored; .env.example never holds secrets.
#     cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- SAFETY
# While true, EVERY provider call is routed to the local mock adapter and nothing
# is billable. The full draft -> approve -> final loop runs for $0.
# Flip to false ONLY after you have filled in real, verified prices in rates.json.
KALVID_DRY_RUN=true

# ---------------------------------------------------------------- Supabase
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Server-side only. Bypasses row-level security — never ship this to a browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Project Settings -> Database -> Connection string.
# When this is set to a real value the app uses Postgres instead of SQLite.
#
# USE A POOLER URI, not the "Direct connection" one. Direct connections are
# IPv6-only on new projects and will simply time out from most machines. In the
# Supabase dashboard pick "Session pooler" (or "Transaction pooler") and copy that
# URI — it looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Replace [YOUR-PASSWORD] with your database password (Settings -> Database ->
# Reset database password if you do not have it).
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Force a backend regardless of the above: postgres | sqlite. Leave unset to auto-pick.
# KALVID_DB_BACKEND=postgres

# Storage -> Buckets. Where finished renders get uploaded for client delivery.
SUPABASE_STORAGE_BUCKET=kalvid-renders
# Signed-URL lifetime, seconds, when handing a render to a client (default 7 days).
SUPABASE_SIGNED_URL_TTL=604800

# ---------------------------------------------------------------- Providers
# fal.ai — primary FINAL-stage provider.  https://fal.ai/dashboard/keys
FAL_KEY=YOUR_FAL_KEY

# Runware — cheap DRAFT-stage provider.  https://my.runware.ai/keys
RUNWARE_API_KEY=YOUR_RUNWARE_API_KEY

# ---------------------------------------------------------------- Storage/paths
KALVID_DB=./data/kalvid.db
KALVID_OUTPUT_DIR=./outputs
KALVID_RATES=./rates.json

# ---------------------------------------------------------------- Cost controls
# Flag a price in rates.json that has not been re-verified in this many days.
KALVID_RATE_STALENESS_DAYS=30
# Warn when a settled cost differs from the pre-call estimate by more than this %.
KALVID_COST_DRIFT_PCT=25

# ---------------------------------------------------------------- Draft stage
# 'video' = short low-res clip (default; the only draft that predicts motion).
# 'image' = single still. Cheaper, but cannot catch motion artifacts.
KALVID_DRAFT_KIND=video
KALVID_DRAFT_DURATION=3

# ---------------------------------------------------------------- Worker
KALVID_POLL_INTERVAL=5
KALVID_POLL_TIMEOUT=1800

# ---------------------------------------------------------------- Dashboard
KALVID_HOST=127.0.0.1
KALVID_PORT=8000
# Name recorded against budget overrides in the audit log.
KALVID_OPERATOR=your-name
